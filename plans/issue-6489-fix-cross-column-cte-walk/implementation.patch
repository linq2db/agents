+		// Recursive branches whose columns read each other through the CTE, by how many columns a branch column reads:
+		// "self" - each column reads itself; "two" - ParentID also reads Level; "three" - ChildID also reads ParentID.
+		static CteClause RecursiveColumnsCte(ITestDataContext db, string reads, int branches)
+		{
+			var cte = db.GetCte<HierarchyLevelCte>(cte =>
+			{
+				var query = db.Parent
+					.Select(p => new HierarchyLevelCte
+					{
+						ParentID = p.ParentID,
+						ChildID  = p.ParentID,
+						Level    = 0,
+					});
+
+				for (var i = 0; i < branches; i++)
+				{
+					var k      = i;
+					var source = cte.Where(ct => ct.Level < 3 && ct.ParentID % branches == k);
+
+					query = query.Concat(reads switch
+					{
+						"self" => source.Select(ct => new HierarchyLevelCte { ParentID = ct.ParentID,            ChildID = ct.ChildID,               Level = ct.Level + 1 }),
+						"two"  => source.Select(ct => new HierarchyLevelCte { ParentID = ct.ParentID + ct.Level, ChildID = ct.ChildID,               Level = ct.Level + 1 }),
+						_      => source.Select(ct => new HierarchyLevelCte { ParentID = ct.ParentID + ct.Level, ChildID = ct.ChildID + ct.ParentID, Level = ct.Level + 1 }),
+					});
+				}
+
+				return query;
+			});
+
+			return cte
