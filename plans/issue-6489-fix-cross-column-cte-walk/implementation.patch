+		// A recursive CTE whose columns read each other: Len <- Name, Name <- Len (as string), Total <- Len and Name.
+		// Total's walk answers Len first, with Name walked in full below it; a later walk of Name, with Name on the path,
+		// must not take Len's answer, because a fresh walk of Len cuts at Name - a string, so nullable - instead.
+		[Test(Description = "https://github.com/linq2db/linq2db/issues/6489")]
+		public void RecursiveCteColumnsReadingEachOther()
+		{
